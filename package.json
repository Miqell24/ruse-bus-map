{
  "name": "ruse-bus-map",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Interactive map of Ruse public transport (19 bus + 7 trolleybus lines) — GTFS synthesised from the operator's timetables + OSM geocoding + HMM map matching",
  "scripts": {
    "download": "bash pipeline/download.sh",
    "feed": "node pipeline/ruse-feed.mjs",
    "build": "node --max-old-space-size=4096 pipeline/build.mjs --all",
    "lines": "node --max-old-space-size=4096 pipeline/lines.mjs",
    "report": "node pipeline/report-gaps.mjs",
    "audit": "node --max-old-space-size=4096 pipeline/audit.mjs",
    "serve": "node pipeline/serve.mjs 8177"
  }
}
